# ── Gemini API ────────────────────────────────────────────────────────────────
# Get it free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# ── Google Calendar ───────────────────────────────────────────────────────────
# Paste the ENTIRE contents of the downloaded service account JSON file
# GCP Console → Service Accounts → Keys → Add Key → JSON
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"janani-reader@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Your calendar's ID — for primary calendar this is just your Gmail address
# Find it: Google Calendar → Settings → scroll down → "Calendar ID"
GOOGLE_CALENDAR_ID=you@gmail.com

# ── Pexels API ────────────────────────────────────────────────────────────────
# Get it free at: https://www.pexels.com/api/
PEXELS_API_KEY=...

# ── Dev.to API ────────────────────────────────────────────────────────────────
# dev.to → Settings → Extensions → DEV API Keys → Generate
DEVTO_API_KEY=...

# ── Gmail SMTP ────────────────────────────────────────────────────────────────
# Use an App Password — NOT your real Gmail password
# Google Account → Security → 2-Step Verification → App Passwords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Who receives the daily digest email (can be same as GMAIL_ADDRESS)
NOTIFY_EMAIL=you@gmail.com
